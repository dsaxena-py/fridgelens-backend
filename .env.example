# Copy to .env and fill in. Never commit .env.

# Supabase dashboard -> Connect -> Session pooler (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API Keys -> service_role (secret). Used only to store scan photos.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy shared JWT secret; new projects verify via JWKS automatically.
SUPABASE_JWT_SECRET=

# memory = keep photos in RAM (local development only)
STORAGE=supabase

# fake = fixed sample detections until a model is trained; onnx = load MODEL_PATH
DETECTOR=fake
MODEL_PATH=models/meallens-yolo11s-v1.onnx
FAKE_DETECTIONS=egg:0.92,tomato:0.88,cheese:0.81,onion:0.42

CORS_ORIGINS=["*"]
